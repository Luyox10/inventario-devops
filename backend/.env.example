# =====================================================
# Variables de entorno del backend (INVENTARIO-DEVOPS)
# =====================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a GitHub.

# Servidor
PORT=3001
CORS_ORIGIN=*

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_this_password
DB_NAME=inventario
DB_TIMEZONE=America/Lima

# SSL de la base de datos (true/false)
DB_SSL_REQUIRED=false

# Ruta relativa al certificado CA de la BD (solo si DB_SSL_REQUIRED=true)
# El certificado ca.pem incluido en el repo es el certificado raiz publico de ISRG/Let's Encrypt.
DB_SSL_CA_PATH=ca.pem

# JWT (firma simetrica HS256)
# Usa un secreto aleatorio de al menos 32 bytes (ej: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_random_long_string
JWT_EXPIRES_IN=1h
JWT_ISSUER=bodega-helena
JWT_AUDIENCE=bodega-helena-web

# Argon2id (parametros OWASP; subir memoryCost requiere mas RAM)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Anti fuerza bruta por cuenta (ademas del rate limit por IP)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Bootstrap del usuario admin
BOOTSTRAP_SECRET=change_this_bootstrap_secret

# Servicio de ML
ML_SERVICE_URL=http://localhost:5001
