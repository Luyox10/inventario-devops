# =====================================================
# Variables de entorno del backend (INVENTARIO-DEVOPS)
# =====================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a GitHub.

# Servidor
PORT=3001
CORS_ORIGIN=*

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_this_password
DB_NAME=inventario
DB_TIMEZONE=America/Lima

# SSL de la base de datos (true/false)
DB_SSL_REQUIRED=false

# Ruta relativa al certificado CA de la BD (solo si DB_SSL_REQUIRED=true)
# El certificado ca.pem incluido en el repo es el certificado raiz publico de ISRG/Let's Encrypt.
DB_SSL_CA_PATH=ca.pem

# JWT
JWT_SECRET=change_this_to_a_random_long_string
JWT_EXPIRES_IN=1d

# Bootstrap del usuario admin
BOOTSTRAP_SECRET=change_this_bootstrap_secret

# Servicio de ML
ML_SERVICE_URL=http://localhost:5001
